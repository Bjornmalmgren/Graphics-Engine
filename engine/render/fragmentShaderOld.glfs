#version 430
layout(location=2) in vec2 TexCord;
layout(location=0) in vec3 color;
out vec4 Color;

uniform sampler2D Texture;
uniform sampler2D emissive;
uniform sampler2D metal;
uniform sampler2D AO;
uniform sampler2D normalMap;
uniform int hasEmissive;



uniform vec3 lightColor;
uniform float specularStrength;
uniform int hasTexture;
uniform int hasNormalMap;
uniform float shiny;
layout(location=3) in vec3 Normal;
layout(location=1) in vec3 FragPos;
layout(location=4) in vec4 Tangent;
uniform vec3 lightPos;
uniform vec3 cameraPos;
uniform vec3 lightDirection;
vec4 PointLight();
vec4 DirectionalLight();
vec3 BumpedNomal();

void main()
{
    
	
   //normal = Normal;
	if(lightDirection.x != 0 && lightDirection.y != 0 && lightDirection.z != 0){
		Color = DirectionalLight();
	}else if(specularStrength != 0){
		Color = PointLight();
	}
	else{
		Color = vec4(color,1);
	}
	if(hasTexture == 1){

	Color *= texture(Texture,TexCord);
	
	
		if(hasEmissive == 1){
			//Color*=texture(emissive,TexCord);
		}
	}


};

vec3 BumpedNomal(){

	vec3 normal = normalize(Normal);

	vec3 tangent = normalize(Tangent.xyz);
	tangent = normalize(tangent - dot(tangent, normal) * normal);
	vec3 biTangent = cross(normal,tangent)* Tangent.w;
	vec3 BumpMap = texture(normalMap, TexCord).xyz;
	BumpMap =2.0*BumpMap - vec3(1,1,1);
	vec3 NewNormal;
	mat3 tbn = mat3(tangent, biTangent, normal);
	NewNormal = tbn * BumpMap;
	NewNormal = normalize(NewNormal);
	return NewNormal;
}

vec4 PointLight(){
    vec3 norm ;
	if(hasNormalMap == 1 && Tangent.x != 0&& Tangent.y != 0&& Tangent.z != 0&& Tangent.w != 0){
		 norm  = BumpedNomal();
	}else{
		 norm = normalize(Normal);
	}
	float ambientStrength = 0.1;

    vec3 ambient = ambientStrength * lightColor;
	vec3 lightDir = normalize(lightPos - FragPos);
	float diff = max(dot(norm,lightDir),0.0);
	vec3 diffuse = diff * lightColor;
	
	vec3 viewDir = normalize(cameraPos-FragPos);
	vec3 halfDir = normalize(lightDir + viewDir);
	float spec = pow(max(dot(norm, halfDir), 0.0), shiny);
	vec3 specular = specularStrength * spec *lightColor;
	vec3 result = (ambient + diffuse + specular);
	return vec4(result,1.0);
};
vec4 DirectionalLight(){
	vec3 norm ;
	if(hasNormalMap == 1&& Tangent.x != 0&& Tangent.y != 0&& Tangent.z != 0&& Tangent.w != 0){
		 norm  = BumpedNomal();
	}else{
		 norm = normalize(Normal);
	}

	float ambientStrength = 0.1;
	
    vec3 ambient = ambientStrength * lightColor;
	vec3 lightDir = normalize(-lightDirection);
	float diff = max(dot(norm,lightDir),0.0);
	vec3 diffuse = diff * lightColor;
	
	vec3 viewDir = normalize(cameraPos-FragPos);
	vec3 halfDir = normalize(lightDir + viewDir);
	float spec = pow(max(dot(norm, halfDir), 0.0), shiny);
	vec3 specular = specularStrength * spec *lightColor;
	vec3 result = (ambient + diffuse + specular);
	return vec4(result,1.0);
};