#version 430
layout(location=0) in vec3 pos;
layout(location=1) in vec4 color;
layout(location=2) in vec2 texCord;
layout(location=3) in vec3 normal;
layout(location=4) in vec4 tangent;
layout(location=0) out vec4 Color;
layout(location=2) out vec2 TexCord;
uniform mat4 rotation;
uniform mat4 view;
uniform mat4 projection;
uniform mat4 transform;

layout(location=1) out vec3 FragPos;
layout(location=3) out vec3 Normal;
layout(location=4) out vec4 Tangent;
void main()
{
	mat4 model = transform*rotation;
	gl_Position = model*vec4(pos, 1)* view* projection ;
	FragPos = vec3(model * vec4(pos,1));
	Color = color;
   	TexCord = texCord;

	
	Tangent = (model * vec4(tangent.xyz ,0.0));
	Tangent.w = tangent.w;
	
	
	Normal = (transpose(inverse(model)) * vec4(normal ,0.0)).xyz;

};