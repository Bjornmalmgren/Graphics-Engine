#version 430
layout(location = 0) in vec3 pos;
layout(location = 2) in vec2 texCoords;

uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;
layout (location = 4)out vec2 TexCoords;
void main(){
    TexCoords = texCoords; 
    vec4 worldPos =vec4(pos, 1)*model;
    gl_Position = worldPos*view*projection;
}
